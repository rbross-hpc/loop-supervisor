{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "argo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Argo",
      "options": {
        "baseURL": "https://apps.inside.anl.gov/argoapi/v1/",
        "apiKey": "{env:ARGO_API_KEY}"
      },
      "models": {
        "Claude Sonnet 4.6": {
          "name": "Claude Sonnet 4.6"
        },
        "Claude Sonnet 5": {
          "name": "Claude Sonnet 5"
        },
        "Claude Opus 4.7": {
          "name": "Claude Opus 4.7"
        },
        "Claude Opus 4.8": {
          "name": "Claude Opus 4.8"
        },
        "GPT-5.6 Sol": {
          "name": "GPT-5.6 Sol"
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/workspaces/loop-tui-experiment": "allow"
    }
  },
  "mcp": {
    "falda": {
      "type": "remote",
      "url": "http://falda:8079/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:FALDA_TOKEN}",
        "X-Falda-Tenant": "lte-project"
      }
    }
  }
}
